# Ctrl / Cmd + トラックボールのズーム用段送り (src/input_processor_zoom_step.c)。
# HID の API を使うので central (または非スプリット) のみ。
# DT ノードは mona2_r.overlay (central) にだけある。
config ZMK_INPUT_PROCESSOR_ZOOM_STEP
    bool
    default y
    depends on DT_HAS_ZMK_INPUT_PROCESSOR_ZOOM_STEP_ENABLED
    depends on ZMK_POINTING
    depends on !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL
