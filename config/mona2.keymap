#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define WIN_BASE       0
#define MAC_BASE       1

#define NUM_WIN        2
#define NUM_MAC        3

#define SYM2_WIN       4
#define SYM2_MAC       5

#define MOUSE_WIN      6
#define MOUSE_MAC      7

#define SCROLL_WIN     8
#define SCROLL_MAC     9

#define FUNCTION_WIN   10
#define FUNCTION_MAC   11

#define BLE_CONFIG     12

#define GESTURE_0      13
#define GESTURE_1      14
#define GESTURE_2      15
#define GESTURE_3      16
#define GESTURE_4      17

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };

        mg_set_3: behavior_mg_set_3 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 3";
        };

        mg_set_4: behavior_mg_set_4 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 4";
        };

        mg_set_5: behavior_mg_set_5 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 5";
        };

        mg_set_6: behavior_mg_set_6 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 6";
        };

        mg_set_7: behavior_mg_set_7 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 7";
        };

        mg_set_8: behavior_mg_set_8 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 8";
        };

        mg_set_9: behavior_mg_set_9 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 9";
        };
    };
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <250>;
    require-prior-idle-ms = <125>;
    tapping-term-ms = <180>;
};

&lt {
    quick-tap-ms = <250>;
    flavor = "balanced";
    require-prior-idle-ms = <125>;
    tapping-term-ms = <180>;
};

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };

    /*
     * 既存コンボは静的コンボとして維持する。
     * DYA Studioのruntime comboスロットは消費しない。
     */
    combos {
        compatible = "zmk,combos";

        layer4_ESC {
            bindings = <&lt GESTURE_0 ESC>;
            key-positions = <39 38>;
        };

        tab1 {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <21 22>;
        };

        BS {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        LANG_2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
        };

        LANG_1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 18>;
        };

        Layer_6 {
            bindings = <&mo BLE_CONFIG>;
            key-positions = <29 30>;
        };

        /*
         * 旧Layer_4コンボ。
         * Macレイヤー使用中でもSCROLL_WINへ移動する。
         */
        Layer_4 {
            bindings = <&mo SCROLL_WIN>;
            key-positions = <31 30>;
        };

        Soft-Off {
            bindings = <&soft_off>;
            key-positions = <17 18 12 13 37 40>;
        };

        ctrl_alt_tab {
            bindings = <&kp LA(LC(TAB))>;
            key-positions = <2 3>;
        };

        Ring_Menu {
            bindings = <&Left_Right_Click>;
            key-positions = <29 31>;
        };
    };

    /*
     * DYA Studioのruntime comboスロットはすべて空ける。
     */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";
    };

    /*
     * 移行先の既存マクロを維持する。
     * BrowsToExploreeとLeft_Right_Clickを追加する。
     * P1はDYA Studioで再設定するため記載しない。
     */
    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on WIN_BASE>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on MAC_BASE>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };

        BrowsToExploree: BrowsToExploree {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(LA(B))>,
                <&kp ENTER>,
                <&kp LG(NUMBER_1)>;

            label = "BROWSTOEXPLOREE";
        };

        Left_Right_Click: Left_Right_Click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&mkp LCLK &mkp RCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &mkp RCLK>;

            label = "LEFT_RIGHT_CLICK";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        /*
         * レイヤーごとの回転動作はDYA Studioで再設定する。
         */
        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;
            bindings = <&zfold LEFT_SHIFT Z>, <&kp LS(Z)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        win_layer {
            display-name = "WIN";

            bindings = <
&lt GESTURE_4 Q  &lt GESTURE_1 L  &lt GESTURE_3 U  &lt GESTURE_0 COMMA       &lt GESTURE_2 PERIOD                                         &kp F       &kp W  &kp R       &kp Y              &kp P
&mt LCTRL E       &kp I             &lt FUNCTION_WIN A &lt MOUSE_WIN O         &kp MINUS                                 &kp F13     &kp K       &kp T       &lt FUNCTION_WIN N &kp S              &kp H
&mt LSHIFT Z      &kp X             &kp C              &kp V                   &kp SEMICOLON  &kp LA(LG(K))         &kp C_MUTE  &kp G       &kp D       &kp M              &mt RALT J         &lt MOUSE_WIN B
&kp LALT          &kp LEFT_WIN      &kp TAB            &mt LSHIFT INT_MUHENKAN  &lt SCROLL_WIN ENTER  &mt LCTRL BACKSPACE  &lt SYM2_WIN DEL  &lt NUM_WIN SPACE                          &mt RSHIFT INT_HENKAN
            >;

            sensor-bindings =
                <&rsr_default>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /*
         * Windowsベースと同じキー構成。
         * レイヤー移動先だけMac側へ変更する。
         */
        mac_layer {
            display-name = "MAC";

            bindings = <
&lt GESTURE_4 Q  &lt GESTURE_1 L  &lt GESTURE_3 U  &lt GESTURE_0 COMMA       &lt GESTURE_2 PERIOD                                         &kp F       &kp W  &kp R       &kp Y              &kp P
&mt LCTRL E       &kp I             &lt FUNCTION_MAC A &lt MOUSE_MAC O         &kp MINUS                                 &kp F13     &kp K       &kp T       &lt FUNCTION_MAC N &kp S              &kp H
&mt LSHIFT Z      &kp X             &kp C              &kp V                   &kp SEMICOLON  &kp LA(LG(K))         &kp C_MUTE  &kp G       &kp D       &kp M              &mt RALT J         &lt MOUSE_MAC B
&kp LALT          &kp LEFT_WIN      &kp TAB            &mt LSHIFT INT_MUHENKAN  &lt SCROLL_MAC ENTER  &mt LCTRL BACKSPACE  &lt SYM2_MAC DEL  &lt NUM_MAC SPACE                          &mt RSHIFT INT_HENKAN
            >;

            sensor-bindings =
                <&rsr_default>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        num_win {
            display-name = "NUM_W";

            bindings = <
&kp NUMBER_1              &kp NUMBER_2              &kp NUMBER_3  &kp NUMBER_4              &kp NUMBER_5                                      &kp NUMBER_6  &kp NUMBER_7          &kp NUMBER_8       &kp NUMBER_9          &kp NUMBER_0
&kp EQUAL                 &kp LEFT_BRACKET          &kp SLASH     &kp MINUS                 &kp LS(INTERNATIONAL_1)                   &trans  &kp SEMICOLON  &kp SQT               &kp RIGHT_BRACKET  &kp BACKSLASH         &kp INT_YEN
&kp LS(LA(LC(NUMBER_2)))  &kp LS(LA(LC(NUMBER_6)))  &kp PSCRN     &kp LS(LG(S))             &kp LA(PSCRN)            &kp LG(LS(V))    &trans  &kp CAPSLOCK   &kp LS(LC(NUMBER_2))  &kp LS(LC(I))      &kp LS(LC(NUMBER_1))  &kp SCROLLLOCK
&trans                    &trans                    &trans        &mt LSHIFT LANGUAGE_1     &trans                   &trans           &trans  &trans                                                                        &to MOUSE_WIN
            >;

            sensor-bindings = <&rsr_default>;
        };

        num_mac {
            display-name = "NUM_M";

            bindings = <
&kp NUMBER_1              &kp NUMBER_2              &kp NUMBER_3  &kp NUMBER_4              &kp NUMBER_5                                      &kp NUMBER_6  &kp NUMBER_7          &kp NUMBER_8       &kp NUMBER_9          &kp NUMBER_0
&kp EQUAL                 &kp LEFT_BRACKET          &kp SLASH     &kp MINUS                 &kp LS(INTERNATIONAL_1)                   &trans  &kp SEMICOLON  &kp SQT               &kp RIGHT_BRACKET  &kp BACKSLASH         &kp INT_YEN
&kp LS(LA(LC(NUMBER_2)))  &kp LS(LA(LC(NUMBER_6)))  &kp PSCRN     &kp LS(LG(S))             &kp LA(PSCRN)            &kp LG(LS(V))    &trans  &kp CAPSLOCK   &kp LS(LC(NUMBER_2))  &kp LS(LC(I))      &kp LS(LC(NUMBER_1))  &kp SCROLLLOCK
&trans                    &trans                    &trans        &mt LSHIFT LANGUAGE_1     &trans                   &trans           &trans  &trans                                                                        &to MOUSE_MAC
            >;

            sensor-bindings = <&rsr_default>;
        };

        sym2_win {
            display-name = "SYM2_W";

            bindings = <
&kp LS(NUMBER_1)   &kp LS(NUMBER_2)    &kp LS(NUMBER_3)  &kp LS(NUMBER_4)          &kp LS(N5)                                        &kp LS(NUMBER_6)  &kp LS(N7)          &kp LS(N8)             &kp LS(N9)             &kp LS(N0)
&kp LS(EQUAL)      &kp LS(LEFT_BRACE)  &kp QUESTION      &kp LS(UNDERSCORE)        &kp LS(INTERNATIONAL_1)                   &trans  &kp LS(SEMICOLON) &kp LS(SQT)         &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)      &kp LS(INT_YEN)
&kp LS(LA(MINUS))  &trans              &trans            &BrowsToExploree          &none                    &kp LG(LA(U))    &trans  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LA(LC(LG(D)))      &kp LA(LC(LG(LEFT)))   &kp LA(LC(LG(RIGHT)))
&trans             &trans              &trans            &mt LSHIFT LANGUAGE_2     &trans                   &trans           &trans  &trans                                                                                &kp LC(LG(F4))
            >;

            sensor-bindings = <&rsr_default>;
        };

        sym2_mac {
            display-name = "SYM2_M";

            bindings = <
&kp LS(NUMBER_1)   &kp LS(NUMBER_2)    &kp LS(NUMBER_3)  &kp LS(NUMBER_4)          &kp LS(N5)                                        &kp LS(NUMBER_6)  &kp LS(N7)          &kp LS(N8)             &kp LS(N9)             &kp LS(N0)
&kp LS(EQUAL)      &kp LS(LEFT_BRACE)  &kp QUESTION      &kp LS(UNDERSCORE)        &kp LS(INTERNATIONAL_1)                   &trans  &kp LS(SEMICOLON) &kp LS(SQT)         &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)      &kp LS(INT_YEN)
&kp LS(LA(MINUS))  &trans              &trans            &BrowsToExploree          &none                    &kp LG(LA(U))    &trans  &kp LC(LG(LEFT))  &kp LC(LG(RIGHT))  &kp LA(LC(LG(D)))      &kp LA(LC(LG(LEFT)))   &kp LA(LC(LG(RIGHT)))
&trans             &trans              &trans            &mt LSHIFT LANGUAGE_2     &trans                   &trans           &trans  &trans                                                                                &kp LC(LG(F4))
            >;

            sensor-bindings = <&rsr_default>;
        };

        mouse_win {
            display-name = "MOUSE_W";

            bindings = <
&kp ESCAPE  &kp N7        &kp N8            &kp N9        &trans                          &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans          &trans
&kp EQUAL   &kp NUMBER_4  &kp N5            &kp NUMBER_6  &kp KP_MINUS            &trans  &mkp MB5    &trans        &mo SCROLL_WIN  &trans          &mkp MB5
&kp N0      &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3  &kp KP_PLUS   &trans    &trans  &mkp MB4    &mkp MB1        &mkp MB3        &mkp MB2  &mkp MB4
&kp DOT     &kp COMMA     &kp LEFT_BRACKET  &trans        &trans        &trans    &trans  &trans                                                  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        mouse_mac {
            display-name = "MOUSE_M";

            bindings = <
&kp ESCAPE  &kp N7        &kp N8            &kp N9        &trans                          &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans          &trans
&kp EQUAL   &kp NUMBER_4  &kp N5            &kp NUMBER_6  &kp KP_MINUS            &trans  &mkp MB5    &trans        &mo SCROLL_MAC  &trans          &mkp MB5
&kp N0      &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3  &kp KP_PLUS   &trans    &trans  &mkp MB4    &mkp MB1        &mkp MB3        &mkp MB2  &mkp MB4
&kp DOT     &kp COMMA     &kp LEFT_BRACKET  &trans        &trans        &trans    &trans  &trans                                                  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        scroll_win {
            display-name = "SCRL_W";

            bindings = <
&trans      &kp LC(N7)        &kp LC(N8)        &kp LC(N9)        &trans                    &kp LANGUAGE_2      &kp N7  &kp N8  &kp N9  &kp KP_SLASH
&trans      &kp LC(NUMBER_4)  &kp LC(N5)        &kp LC(NUMBER_6)  &trans            &trans  &kp LS(UNDERSCORE)  &kp N4  &kp N5  &kp N6  &kp KP_ASTERISK
&kp LC(N0)  &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &trans  &trans    &trans  &kp N0              &kp N1  &kp N2  &kp N3  &kp KP_MINUS
&trans      &trans            &trans            &trans            &trans  &trans    &trans  &kp DOT                                     &kp KP_PLUS
            >;

            sensor-bindings = <&rsr_default>;
        };

        scroll_mac {
            display-name = "SCRL_M";

            bindings = <
&trans      &kp LC(N7)        &kp LC(N8)        &kp LC(N9)        &trans                    &kp LANGUAGE_2      &kp N7  &kp N8  &kp N9  &kp KP_SLASH
&trans      &kp LC(NUMBER_4)  &kp LC(N5)        &kp LC(NUMBER_6)  &trans            &trans  &kp LS(UNDERSCORE)  &kp N4  &kp N5  &kp N6  &kp KP_ASTERISK
&kp LC(N0)  &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &trans  &trans    &trans  &kp N0              &kp N1  &kp N2  &kp N3  &kp KP_MINUS
&trans      &trans            &trans            &trans            &trans  &trans    &trans  &kp DOT                                     &kp KP_PLUS
            >;

            sensor-bindings = <&rsr_default>;
        };

        function_win {
            display-name = "FN_W";

            bindings = <
&kp ESC  &kp F1  &kp F2   &kp F3   &kp F4                     &kp INS        &kp HOME       &kp UP    &kp END    &kp PG_UP
&trans   &kp F5  &kp F6   &kp F7   &kp F8             &trans  &kp LC(TAB)    &kp LEFT       &kp UP    &kp RIGHT  &kp PG_DN
&trans   &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp LS(LG(V))  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LC(LA(LG(V)))
&trans   &trans  &trans   &trans   &trans   &trans    &trans  &kp INT_HENKAN                                  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        function_mac {
            display-name = "FN_M";

            bindings = <
&kp ESC  &kp F1  &kp F2   &kp F3   &kp F4                     &kp INS        &kp HOME       &kp UP    &kp END    &kp PG_UP
&trans   &kp F5  &kp F6   &kp F7   &kp F8             &trans  &kp LC(TAB)    &kp LEFT       &kp UP    &kp RIGHT  &kp PG_DN
&trans   &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp LS(LG(V))  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LC(LA(LG(V)))
&trans   &trans  &trans   &trans   &trans   &trans    &trans  &kp INT_HENKAN                                  &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Windows/Mac共通のBLE・設定レイヤー
         */
        ble_config {
            display-name = "BLE";

            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4                           &BT0          &BT1          &trans  &trans  &trans
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4                  &trans  &out OUT_TOG  &trans        &trans  &trans  &studio_unlock
&bt BT_SEL 5   &bt BT_SEL 6   &trans         &studio_unlock  &out OUT_BLE   &out OUT_USB    &bootloader   &trans        &trans  &trans  &trans  &bt BT_CLR
&bt BT_DISC 5  &bt BT_DISC 6  &trans         &trans          &trans         &bt BT_CLR      &trans        &bootloader                          &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * DYA Studioでマウスジェスチャーを定義するための専用レイヤー。
         * gestures.dtsiは読み込まない。
         */

        gesture_0 {
            display-name = "GESTURE_0";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        gesture_1 {
            display-name = "GESTURE_1";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        gesture_2 {
            display-name = "GESTURE_2";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        gesture_3 {
            display-name = "GESTURE_3";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };

        gesture_4 {
            display-name = "GESTURE_4";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;
        };
    };
};

/*
 * 旧SYM2レイヤーで使用していたスクロール5倍設定を、
 * Windows/Mac両方のSYM2へ適用する。
 */
&msc_input_listener {
    speed_up {
        layers = <SYM2_WIN SYM2_MAC>;
        input-processors = <&zip_wheel_scaler 5 1>;
    };
};
