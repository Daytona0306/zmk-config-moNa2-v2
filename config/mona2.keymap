#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/default_layer.dtsi>
#include <dt-bindings/zmk_behavior_default_layer/default_layer.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * 従来のレイヤー方式によるマウスジェスチャー。
 *
 * gestures.dtsi内の対象レイヤー:
 *
 *  6  Arrow
 *  8  Tab Control
 *  9  Virtual Desktop
 * 10  Navigation
 * 11  Window Management
 * 12  PowerToys
 */

#include "gestures.dtsi"

/*
 * Layer layout
 *
 *  0  Windows base
 *  1  Mac / iPad base
 *  2  Number / Symbol 1
 *  3  Symbol 2
 *  4  Mouse
 *  5  Number / Scroll
 *  6  Function / Navigation / Arrow Gesture
 *  7  BLE / Configuration
 *  8  Tab Control Gesture
 *  9  Virtual Desktop Gesture
 * 10  Navigation Gesture
 * 11  Window Management Gesture
 * 12  PowerToys Gesture
 */

#define WIN_BASE       0
#define MAC_BASE       1
#define NUM_LAYER      2
#define SYM2_LAYER     3
#define MOUSE_LAYER    4
#define SCROLL_LAYER   5
#define FUNCTION_LAYER 6
#define BLE_CONFIG     7

#define GESTURE_0      8
#define GESTURE_1      9
#define GESTURE_2      10
#define GESTURE_3      11
#define GESTURE_4      12

/*
 * ZMK側の既定値を上書きする。
 */

#undef ZMK_POINTING_DEFAULT_SCRL_VAL
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

/*
 * Mouse Gesture Studio用ビヘイビア。
 *
 * 従来のレイヤー方式とは別系統。
 * 当面はキーへ割り当てず、DYA Studioから必要に応じて使用する。
 *
 * Mouse Gesture Studioが認識するKey 0～2のみを定義する。
 */

/ {
    behaviors {
        mg_set_0: behavior_mg_set_0 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 0";
        };

        mg_set_1: behavior_mg_set_1 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 1";
        };

        mg_set_2: behavior_mg_set_2 {
            compatible = "zmk,behavior-mg-set-fixed";
            #binding-cells = <0>;
            display-name = "Mouse Gesture Key 2";
        };
    };
};

/*
 * Mod-Tap
 */

&mt {
    flavor = "balanced";
    quick-tap-ms = <250>;
    require-prior-idle-ms = <125>;
    tapping-term-ms = <180>;
};

/*
 * Layer-Tap
 */

&lt {
    quick-tap-ms = <250>;
    flavor = "balanced";
    require-prior-idle-ms = <125>;
    tapping-term-ms = <180>;
};

/*
 * Mouse scroll
 */

&msc {
    delay-ms = <0>;
    time-to-max-speed-ms = <0>;
    acceleration-exponent = <0>;
};

/ {
    /*
     * SYM2レイヤーでスクロールを5倍にするinput processor。
     */

    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
            track-remainders;
        };
    };

    /*
     * 既存コンボ
     *
     * 静的コンボとして保持する。
     * DYA Studioのruntime comboスロットは使用しない。
     *
     * runtime_combo_defaultsは記載しない。
     */

    combos {
        compatible = "zmk,combos";

        gesture_esc {
            bindings = <&lt GESTURE_0 ESC>;
            key-positions = <39 38>;
        };

        tab1 {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <21 22>;
        };

        bs {
            bindings = <&kp BACKSPACE>;
            key-positions = <8 9>;
        };

        lang_2 {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
        };

        lang_1 {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <17 18>;
        };

        ble_config_combo {
            bindings = <&mo BLE_CONFIG>;
            key-positions = <29 30>;
        };

        num_scroll_combo {
            bindings = <&mo SCROLL_LAYER>;
            key-positions = <31 30>;
        };

        soft_off_combo {
            bindings = <&soft_off>;
            key-positions = <17 18 12 13 37 40>;
        };

        ctrl_alt_tab {
            bindings = <&kp LA(LC(TAB))>;
            key-positions = <2 3>;
        };

        ring_menu {
            bindings = <&Left_Right_Click>;
            key-positions = <29 31>;
        };
    };

    /*
     * Static macros
     *
     * P1はDYA Studioでruntime macroとして作成する。
     */

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        BT0: BT0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 0>,
                <&macro_wait_time 500>,
                <&tog_on WIN_BASE>;

            label = "BT0";
        };

        BT1: BT1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&tog_off WIN_BASE &tog_off MAC_BASE>,
                <&macro_wait_time 200>,
                <&bt BT_SEL 1>,
                <&macro_wait_time 500>,
                <&tog_on MAC_BASE>;

            label = "BT1";
        };

        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp RSHIFT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp S>,
                <&macro_release>,
                <&kp LEFT_GUI &kp RSHIFT>;

            label = "SCREENSHOT";
        };

        henkan: henkan {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_wait_time 20>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "HENKAN";
        };

        BrowsToExploree: BrowsToExploree {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&kp LS(LA(B))>,
                <&kp ENTER>,
                <&kp LG(NUMBER_1)>;

            label = "BROWSTOEXPLOREE";
        };

        Left_Right_Click: Left_Right_Click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&macro_press>,
                <&mkp LCLK &mkp RCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&mkp LCLK &mkp RCLK>;

            label = "LEFT_RIGHT_CLICK";
        };
    };

    /*
     * Custom behaviors
     */

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        tp_repeat_mo1: tp_repeat_mo1 {
            compatible = "zmk,behavior-hold-tap";
            label = "TP_REPEAT_MO1";
            bindings = <&mo>, <&key_repeat>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        /*
         * エンコーダはDYA Studioでレイヤーごとに再設定する。
         * コンパイル時の初期値は縦スクロール。
         */

        rsr_default: rsr_default {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <16>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        tog_on: toggle_layer_on_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer On";
            toggle-mode = "on";
        };

        tog_off: toggle_layer_off_only {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            display-name = "Toggle Layer Off";
            toggle-mode = "off";
        };

        zfold: zfold {
            compatible = "zmk,behavior-hold-tap";
            label = "ZFOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "hold-preferred";
            quick-tap-ms = <150>;
            hold-while-undecided;
        };

        zfoldZ: zfoldZ {
            compatible = "zmk,behavior-tap-dance";
            label = "ZFOLDZ";
            #binding-cells = <0>;

            bindings =
                <&zfold LEFT_SHIFT Z>,
                <&kp LS(Z)>;
        };
    };

    /*
     * Keymap
     */

    keymap {
        compatible = "zmk,keymap";

        /*
         * Layer 0
         * Windows base
         */

        win_layer {
            display-name = "WIN";

            bindings = <
&lt GESTURE_4 Q  &lt GESTURE_1 L  &lt GESTURE_3 U       &lt GESTURE_0 COMMA        &lt GESTURE_2 PERIOD                                            &kp F       &kp W  &kp R       &kp Y                &kp P
&mt LCTRL E       &kp I             &lt FUNCTION_LAYER A  &lt MOUSE_LAYER O          &kp MINUS                                  &kp F13     &kp K       &kp T       &lt FUNCTION_LAYER N &kp S                &kp H
&mt LSHIFT Z      &kp X             &kp C                 &kp V                       &kp SEMICOLON  &kp LA(LG(K))          &kp C_MUTE  &kp G       &kp D       &kp M                &mt RALT J           &lt MOUSE_LAYER B
&kp LALT          &kp LEFT_WIN      &kp TAB               &mt LSHIFT INT_MUHENKAN     &lt SCROLL_LAYER ENTER  &mt LCTRL BACKSPACE  &lt SYM2_LAYER DEL  &lt NUM_LAYER SPACE                             &mt RSHIFT INT_HENKAN
            >;

            sensor-bindings =
                <&rsr_default>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /*
         * Layer 1
         * Mac / iPad base
         *
         * Windowsベースと同じ配列。
         * サブレイヤーは共通レイヤーを使用する。
         */

        mac_layer {
            display-name = "MAC";

            bindings = <
&lt GESTURE_4 Q  &lt GESTURE_1 L  &lt GESTURE_3 U       &lt GESTURE_0 COMMA        &lt GESTURE_2 PERIOD                                            &kp F       &kp W  &kp R       &kp Y                &kp P
&mt LCTRL E       &kp I             &lt FUNCTION_LAYER A  &lt MOUSE_LAYER O          &kp MINUS                                  &kp F13     &kp K       &kp T       &lt FUNCTION_LAYER N &kp S                &kp H
&mt LSHIFT Z      &kp X             &kp C                 &kp V                       &kp SEMICOLON  &kp LA(LG(K))          &kp C_MUTE  &kp G       &kp D       &kp M                &mt RALT J           &lt MOUSE_LAYER B
&kp LALT          &kp LEFT_WIN      &kp TAB               &mt LSHIFT INT_MUHENKAN     &lt SCROLL_LAYER ENTER  &mt LCTRL BACKSPACE  &lt SYM2_LAYER DEL  &lt NUM_LAYER SPACE                             &mt RSHIFT INT_HENKAN
            >;

            sensor-bindings =
                <&rsr_default>,
                <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        /*
         * Layer 2
         * Number / Symbol 1
         */

        num_layer {
            display-name = "NUM";

            bindings = <
&kp NUMBER_1              &kp NUMBER_2              &kp NUMBER_3  &kp NUMBER_4               &kp NUMBER_5                                      &kp NUMBER_6   &kp NUMBER_7          &kp NUMBER_8       &kp NUMBER_9          &kp NUMBER_0
&kp EQUAL                 &kp LEFT_BRACKET          &kp SLASH     &kp MINUS                  &kp LS(INTERNATIONAL_1)                   &trans  &kp SEMICOLON  &kp SQT               &kp RIGHT_BRACKET  &kp BACKSLASH         &kp INT_YEN
&kp LS(LA(LC(NUMBER_2)))  &kp LS(LA(LC(NUMBER_6)))  &kp PSCRN     &kp LS(LG(S))              &kp LA(PSCRN)            &kp LG(LS(V))    &trans  &kp CAPSLOCK   &kp LS(LC(NUMBER_2))  &kp LS(LC(I))      &kp LS(LC(NUMBER_1))  &kp SCROLLLOCK
&trans                    &trans                    &trans        &mt LSHIFT LANGUAGE_1      &trans                   &trans           &trans  &trans                                                                        &to MOUSE_LAYER
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 3
         * Symbol 2
         *
         * 旧P1位置はDYA Studioで割り当てるまで無効。
         */

        sym2_layer {
            display-name = "SYM2";

            bindings = <
&kp LS(NUMBER_1)   &kp LS(NUMBER_2)    &kp LS(NUMBER_3)  &kp LS(NUMBER_4)           &kp LS(N5)                                        &kp LS(NUMBER_6)   &kp LS(N7)         &kp LS(N8)             &kp LS(N9)            &kp LS(N0)
&kp LS(EQUAL)      &kp LS(LEFT_BRACE)  &kp QUESTION      &kp LS(UNDERSCORE)         &kp LS(INTERNATIONAL_1)                   &trans  &kp LS(SEMICOLON)  &kp LS(SQT)        &kp LS(RIGHT_BRACKET)  &kp LS(BACKSLASH)     &kp LS(INT_YEN)
&kp LS(LA(MINUS))  &trans              &trans            &BrowsToExploree           &none                    &kp LG(LA(U))    &trans  &kp LC(LG(LEFT))   &kp LC(LG(RIGHT))  &kp LA(LC(LG(D)))      &kp LA(LC(LG(LEFT)))  &kp LA(LC(LG(RIGHT)))
&trans             &trans              &trans            &mt LSHIFT LANGUAGE_2      &trans                   &trans           &trans  &trans                                                                             &kp LC(LG(F4))
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 4
         * Mouse
         */

        mouse_layer {
            display-name = "MOUSE";

            bindings = <
&kp ESCAPE  &kp N7        &kp N8            &kp N9        &trans                          &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &trans             &trans
&kp EQUAL   &kp NUMBER_4  &kp N5            &kp NUMBER_6  &kp KP_MINUS            &trans  &mkp MB5    &trans        &mo SCROLL_LAYER    &trans             &mkp MB5
&kp N0      &kp NUMBER_1  &kp NUMBER_2      &kp NUMBER_3  &kp KP_PLUS   &trans    &trans  &mkp MB4    &mkp MB1          &mkp MB3           &mkp MB2  &mkp MB4
&kp DOT     &kp COMMA     &kp LEFT_BRACKET  &trans        &trans        &trans    &trans  &trans                                                       &to WIN_BASE
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 5
         * Number / Scroll
         */

        scroll_layer {
            display-name = "SCRL";

            bindings = <
&trans      &kp LC(N7)        &kp LC(N8)        &kp LC(N9)        &trans                    &kp LANGUAGE_2      &kp N7  &kp N8  &kp N9  &kp KP_SLASH
&trans      &kp LC(NUMBER_4)  &kp LC(N5)        &kp LC(NUMBER_6)  &trans            &trans  &kp LS(UNDERSCORE)  &kp N4  &kp N5  &kp N6  &kp KP_ASTERISK
&kp LC(N0)  &kp LC(NUMBER_1)  &kp LC(NUMBER_2)  &kp LC(NUMBER_3)  &trans  &trans    &trans  &kp N0              &kp N1  &kp N2  &kp N3  &kp KP_MINUS
&trans      &trans            &trans            &trans            &trans  &trans    &trans  &kp DOT                                     &kp KP_PLUS
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 6
         * Function / Navigation
         *
         * AまたはN長押し中は、gestures.dtsiによって
         * トラックボールが矢印ジェスチャーとして動作する。
         */

        function_layer {
            display-name = "FN";

            bindings = <
&kp ESC  &kp F1  &kp F2   &kp F3   &kp F4                     &kp INS        &kp HOME       &kp UP    &kp END    &kp PG_UP
&trans   &kp F5  &kp F6   &kp F7   &kp F8             &trans  &kp LC(TAB)    &kp LEFT       &kp UP    &kp RIGHT  &kp PG_DN
&trans   &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &kp LS(LG(V))  &kp LEFT       &kp DOWN  &kp RIGHT  &kp LC(LA(LG(V)))
&trans   &trans  &trans   &trans   &trans   &trans    &trans  &kp INT_HENKAN                                   &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 7
         * BLE / Configuration
         */

        ble_config {
            display-name = "BLE";

            bindings = <
&bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3    &bt BT_SEL 4                           &BT0          &BT1          &trans        &trans  &trans
&bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3   &bt BT_DISC 4                  &trans  &out OUT_TOG  &trans        &trans        &trans  &studio_unlock
&bt BT_SEL 5   &bt BT_SEL 6   &trans         &studio_unlock  &out OUT_BLE   &out OUT_USB    &bootloader   &trans        &trans        &trans  &trans  &bt BT_CLR
&bt BT_DISC 5  &bt BT_DISC 6  &trans         &trans          &trans         &bt BT_CLR      &trans        &bootloader                               &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 8
         * Browser Tab Control Gesture
         */

        gesture_0 {
            display-name = "GESTURE_0";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 9
         * Virtual Desktop Gesture
         */

        gesture_1 {
            display-name = "GESTURE_1";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 10
         * Navigation Gesture
         */

        gesture_2 {
            display-name = "GESTURE_2";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 11
         * Window Management Gesture
         */

        gesture_3 {
            display-name = "GESTURE_3";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };

        /*
         * Layer 12
         * PowerToys Gesture
         */

        gesture_4 {
            display-name = "GESTURE_4";

            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&rsr_default>;
        };
    };
};

/*
 * 旧SYM2レイヤーのスクロール5倍設定。
 */

&msc_input_listener {
    speed_up {
        layers = <SYM2_LAYER>;
        input-processors = <&zip_wheel_scaler 5 1>;
    };
};
